            "Recovery" => "Protects the body, lowers camp risk and steadies rough pre-fight weeks.",
            "WeightManagement" => "Makes the cut safer and cleaner, especially useful for tight or draining cuts.",
            _ => "No specific emphasis selected. The camp stays more balanced across every area."
        };

    private IReadOnlyList<string> GetVisibleTraits()
    {
        if (_fighter is null)
            return Array.Empty<string>();

        if (_isManaged)
            return _fighter.Traits;

        if (_fighter.ScoutConfidence < 60)
            return new[] { "Traits unclear" };

        if (_fighter.ScoutConfidence < 80)
            return _fighter.Traits.Take(1).DefaultIfEmpty("Traits emerging").ToArray();

        return _fighter.Traits;
    }
}
