@page "/fighters/{fighterId:int}"
@using MMAAgent.Web.Models
@using MMAAgent.Web.Services

@inject FightProfileReadService FightProfileReadService
@inject WebFighterActionService FighterActionService
@inject WebRosterService RosterService

<PageTitle>Fighter Profile - MMA Agent</PageTitle>

<div class="page-header">
    <div>
        <h1>Fighter Profile</h1>
        <p class="muted-text">Poster view, matchup read, narrative pressure and all the live decisions around this fighter.</p>
    </div>
</div>

@if (_error is not null)
{
    <div class="panel-card error-panel">@_error</div>
}
else if (_loading)
{
    <div class="panel-card">Cargando perfil...</div>
}
else if (_fighter is null)
{
    <div class="panel-card">Fighter not found.</div>
}
else
{
    <div class="fight-profile-layout">
        <section class="panel-card fighter-command-hero">
            <div class="fighter-command-layout">
                <div class="fighter-command-main">
                    <div class="fighter-command-kicker">Fighter HQ</div>

                    <div class="profile-name-row">
                        <h2 class="profile-name">@_fighter.Name</h2>
                        @if (_fighter.IsChampion)
                        {
                            <span class="champion-pill">Champion</span>
                        }
                        @if (_isManaged)
                        {
                            <span class="managed-pill">Managed</span>
                        }
                    </div>

                    <div class="muted-text profile-origin-row">
                        @if (!string.IsNullOrWhiteSpace(_fighter.CountryFlagUrl))
                        {
                            <span class="country-flag-image profile-flag"
                                  role="img"
                                  aria-label="@($"{_fighter.CountryName} flag")"
                                  title="@_fighter.CountryName"
                                  style="@BuildFlagStyle(_fighter.CountryFlagUrl)"></span>
                        }
                        <span>@_fighter.CountryName · @_fighter.WeightClass · Age @_fighter.Age · @_fighter.CareerStage</span>
                    </div>

                    <div class="fighter-command-storyline">
                        <div class="fighter-command-summary">@BuildHeadlineSummary()</div>
                        <div class="muted-text">@BuildIdentitySummary()</div>
                    </div>

                    <div class="fighter-command-actions">
                        @if (_isManaged)
                        {
                            @if (CanSeekFight())
                            {
                                <button class="btn-primary" @onclick="SeekFightAsync">Seek fight</button>
                            }

                            @if (CanAdjustCampFocus())
                            {
                                <a class="btn-secondary" href="#camp-focus-panel">Set camp focus</a>
                            }
                        }
                        else
                        {
                            <button class="@GetSignButtonClass()"
                                    @onclick="SignCurrentFighterAsync">
                                @GetSignButtonText()
                            </button>

                            @if (CanScout())
                            {
                                <button class="btn-secondary"
                                        disabled="@_busyScouting"
                                        @onclick="StartScoutAsync">
                                    Scout fighter
                                </button>
                            }
                            else
                            {
                                <span class="roster-scout-status">@_fighter.ScoutStatus</span>
                            }
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_actionStatus))
                    {
                        <div class="muted-text">@_actionStatus</div>
                    }

                    <div class="fighter-hero-chip-row">
                        <span class="message-badge">Heat: @DescribeHeat(_fighter.MediaHeat)</span>
                        <span class="message-badge">Reliability: @DescribeReliability(_fighter.ReliabilityScore)</span>
                        <span class="message-badge">@_fighter.BaseStyle</span>
                        <span class="message-badge">@_fighter.TacticalStyle</span>
                    </div>
                </div>

                <div class="fighter-command-side">
                    <div class="profile-record fighter-poster-record">
                        <span class="record-win">@_fighter.Wins</span>
                        <span class="record-sep">-</span>
                        <span class="record-loss">@_fighter.Losses</span>
                        <span class="record-sep">-</span>
                        <span class="record-draw">@_fighter.Draws</span>
                    </div>

                    <div class="fighter-mini-grid">
                        <div class="meta-box">
                            <div class="meta-label">Popularity</div>
                            <div class="meta-value">@_fighter.Popularity</div>
                        </div>
                        <div class="meta-box">
                            <div class="meta-label">Marketability</div>
                            <div class="meta-value">@_fighter.Marketability</div>
                        </div>
                        <div class="meta-box">
                            <div class="meta-label">Momentum</div>
                            <div class="meta-value">@_fighter.Momentum</div>
                        </div>
                        <div class="meta-box">
                            <div class="meta-label">Wear</div>
                            <div class="meta-value">@DescribeWear(_fighter.DamageMiles)</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="profile-meta-grid fighter-hero-meta">
                <div class="meta-box">
                    <div class="meta-label">Promotion</div>
                    <div class="meta-value">
                        @if (_fighter.PromotionId is int promotionId && !string.IsNullOrWhiteSpace(_fighter.PromotionName))
                        {
                            <a class="fighter-link profile-promotion-link"
                               href="@($"/promotions/{promotionId}")">
                                @_fighter.PromotionName
                            </a>
                        }
                        else
                        {
                            @(_fighter.PromotionName ?? "Free Agent")
                        }
                    </div>
                </div>
                <div class="meta-box">
                    <div class="meta-label">Circuit</div>
                    <div class="meta-value">@DescribeCircuit(_fighter.PromotionCircuitType, _fighter.CareerStage)</div>
                </div>
                <div class="meta-box">
                    <div class="meta-label">Rank</div>
                    <div class="meta-value">@(_fighter.RankPosition?.ToString() ?? "-")</div>
                </div>
                <div class="meta-box">
                    <div class="meta-label">Contract</div>
                    <div class="meta-value">@_fighter.ContractStatus</div>
                </div>
                <div class="meta-box">
                    <div class="meta-label">Salary</div>
                    <div class="meta-value">@_fighter.Salary</div>
                </div>
                <div class="meta-box">
                    <div class="meta-label">Availability</div>
                    <div class="meta-value">@BuildAvailabilityText()</div>
                </div>
                <div class="meta-box">
                    <div class="meta-label">Current Phase</div>
                    <div class="meta-value">@FormatPhase(_fighter.CurrentPhase)</div>
                </div>
                <div class="meta-box">
                    <div class="meta-label">Next Fight</div>
                    <div class="meta-value">@BuildScheduledFightText()</div>
                </div>
            </div>
        </section>

        <div class="dashboard-live-grid">
            <section class="panel-card fighter-matchup-panel">
                <div class="table-toolbar">
                    <div class="toolbar-title">Next Matchup</div>
                    <div class="toolbar-subtitle">Opponent, event and camp angle for the next booking.</div>
                </div>

                @if (_fighter.IsBooked)
                {
                    <div class="fighter-matchup-top">
                        <div>
                            <div class="fighter-matchup-name">
                                @if (_fighter.ScheduledOpponentId is int opponentId)
                                {
                                    <a class="fighter-link" href="@($"/fighters/{opponentId}")">@(_fighter.ScheduledOpponentName ?? "TBD")</a>
                                }
                                else
                                {
                                    @(_fighter.ScheduledOpponentName ?? "TBD")
                                }
                            </div>
                            <div class="muted-text">@(_fighter.ScheduledOpponentRecord ?? "Record unavailable")</div>
                        </div>
                        <span class="message-badge">@(_fighter.ScheduledEventDate ?? "Date TBD")</span>
                    </div>

                    <div class="dashboard-list">
                        <div class="dashboard-list-item">
                            <strong>Event</strong>
                            <div class="muted-text">@(_fighter.ScheduledEventName ?? "Event TBD")</div>
                        </div>
                        <div class="dashboard-list-item">
                            <strong>Opponent read</strong>
                            <div class="muted-text">@(_fighter.ScheduledOpponentStyleSummary ?? "No strong opponent read yet.")</div>
                        </div>
                        <div class="dashboard-list-item">
                            <strong>Camp focus</strong>
                            <div class="muted-text">@DescribeCampFocus(_fighter.CampFocus)</div>
                        </div>
                        @if (HasCampRecommendation())
                        {
                            <div class="dashboard-list-item">
                                <strong>Staff recommendation</strong>
                                <div class="muted-text">@_fighter.CampRecommendationReason</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="muted-text">No fight is booked right now. Once a bout is signed, this panel becomes your camp and matchup hub.</div>
                }
            </section>

            <section class="panel-card fighter-story-panel">
                <div class="table-toolbar">
                    <div class="toolbar-title">Narrative Pressure</div>
                    <div class="toolbar-subtitle">What the public, the division and the career arc are saying right now.</div>
                </div>

                <div class="fighter-hero-chip-row" style="margin-bottom:14px;">
                    <span class="message-badge">Heat: @DescribeHeat(_fighter.MediaHeat)</span>
                    <span class="message-badge">Reliability: @DescribeReliability(_fighter.ReliabilityScore)</span>
                    <span class="message-badge">Wear: @DescribeWear(_fighter.DamageMiles)</span>
                </div>

                @if (_fighter.Storylines.Count == 0 && _fighter.LegacyTags.Count == 0)
                {
                    <div class="muted-text">This fighter has not built much narrative gravity yet.</div>
                }
                else
                {
                    <div class="dashboard-list">
                        @foreach (var story in _fighter.Storylines.Take(2))
                        {
                            <div class="dashboard-list-item">
                                <strong>@story.Headline</strong>
                                <div class="muted-text">@story.Body</div>
                            </div>
                        }

                        @foreach (var tag in _fighter.LegacyTags.Take(3))
                        {
                            <div class="dashboard-list-item">
                                <strong>@FormatLegacyTag(tag.TagCode)</strong>
                                <div class="muted-text">@tag.Summary</div>
                            </div>
                        }
                    </div>
                }
            </section>
        </div>

        <section class="panel-card">
            <div class="table-toolbar">
                <div class="toolbar-title">@(_isManaged ? "Core Attributes" : "Scout Read")</div>
                <div class="toolbar-subtitle">@(_isManaged ? "Current overall and attribute breakdown" : "Public and estimated reads instead of exact private numbers")</div>
            </div>

            <div class="attribute-grid">
                @if (_isManaged)
                {
                    <div class="attribute-card"><span>Skill</span><strong>@_fighter.Skill</strong></div>
                    <div class="attribute-card"><span>Potential</span><strong>@_fighter.Potential</strong></div>
                    <div class="attribute-card"><span>Popularity</span><strong>@_fighter.Popularity</strong></div>
                    <div class="attribute-card"><span>Marketability</span><strong>@_fighter.Marketability</strong></div>
                    <div class="attribute-card"><span>Momentum</span><strong>@_fighter.Momentum</strong></div>
                    <div class="attribute-card"><span>Striking</span><strong>@_fighter.Striking</strong></div>
                    <div class="attribute-card"><span>Grappling</span><strong>@_fighter.Grappling</strong></div>
                    <div class="attribute-card"><span>Wrestling</span><strong>@_fighter.Wrestling</strong></div>
                    <div class="attribute-card"><span>Cardio</span><strong>@_fighter.Cardio</strong></div>
                    <div class="attribute-card"><span>Chin</span><strong>@_fighter.Chin</strong></div>
                    <div class="attribute-card"><span>Fight IQ</span><strong>@_fighter.FightIQ</strong></div>
                }
                else
                {
                    <div class="attribute-card"><span>Scout Confidence</span><strong>@DescribeConfidence(_fighter.ScoutConfidence)</strong></div>
                    <div class="attribute-card"><span>Skill Read</span><strong>@DescribeRange(_fighter.EstimatedSkillMin, _fighter.EstimatedSkillMax)</strong></div>
                    <div class="attribute-card"><span>Potential Read</span><strong>@DescribeRange(_fighter.EstimatedPotentialMin, _fighter.EstimatedPotentialMax)</strong></div>
                    <div class="attribute-card"><span>Striking Read</span><strong>@DescribeRange(_fighter.EstimatedStrikingMin, _fighter.EstimatedStrikingMax)</strong></div>
                    <div class="attribute-card"><span>Grappling Read</span><strong>@DescribeRange(_fighter.EstimatedGrapplingMin, _fighter.EstimatedGrapplingMax)</strong></div>
                    <div class="attribute-card"><span>Wrestling Read</span><strong>@DescribeRange(_fighter.EstimatedWrestlingMin, _fighter.EstimatedWrestlingMax)</strong></div>
                    <div class="attribute-card"><span>Cardio Read</span><strong>@DescribeRange(_fighter.EstimatedCardioMin, _fighter.EstimatedCardioMax)</strong></div>
                    <div class="attribute-card"><span>Chin Read</span><strong>@DescribeRange(_fighter.EstimatedChinMin, _fighter.EstimatedChinMax)</strong></div>
                    <div class="attribute-card"><span>Fight IQ Read</span><strong>@DescribeRange(_fighter.EstimatedFightIQMin, _fighter.EstimatedFightIQMax)</strong></div>
                    <div class="attribute-card"><span>Popularity</span><strong>@_fighter.Popularity</strong></div>
                    <div class="attribute-card"><span>Marketability</span><strong>@_fighter.Marketability</strong></div>
                }
                <div class="attribute-card"><span>Media Heat</span><strong>@DescribeHeat(_fighter.MediaHeat)</strong></div>
                <div class="attribute-card"><span>Reliability</span><strong>@DescribeReliability(_fighter.ReliabilityScore)</strong></div>
                <div class="attribute-card"><span>Fights Left</span><strong>@_fighter.ContractFightsRemaining / @_fighter.TotalFightsInContract</strong></div>
                @if (string.Equals(_fighter.CareerStage, "Amateur", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="attribute-card"><span>Amateur Record</span><strong>@($"{_fighter.AmateurWins}-{_fighter.AmateurLosses}-{_fighter.AmateurDraws}")</strong></div>
                }
            </div>
        </section>

        <section class="panel-card">
            <div class="table-toolbar">
                <div class="toolbar-title">Fight Identity</div>
                <div class="toolbar-subtitle">Derived combat profile and natural tendencies</div>
            </div>

            <div class="profile-meta-grid" style="margin-bottom:16px;">
                <div class="meta-box">
                    <div class="meta-label">Base Style</div>
                    <div class="meta-value">@_fighter.BaseStyle</div>
                </div>
                <div class="meta-box">
                    <div class="meta-label">Tactical Style</div>
                    <div class="meta-value">@_fighter.TacticalStyle</div>
                </div>
                <div class="meta-box" style="grid-column: span 2;">
                    <div class="meta-label">Style Read</div>
                    <div class="meta-value">@_fighter.StyleSummary</div>
                </div>
            </div>

            <div class="button-row" style="gap:10px; flex-wrap:wrap;">
                @foreach (var trait in GetVisibleTraits())
                {
                    <span class="message-badge">@trait</span>
                }
            </div>
        </section>

        <section class="panel-card" id="camp-focus-panel">
            <div class="table-toolbar">
                <div class="toolbar-title">Current State</div>
                <div class="toolbar-subtitle">Internal condition presented as readable fight-week context</div>
            </div>

            <div class="attribute-grid">
                <div class="attribute-card"><span>Phase</span><strong>@FormatPhase(_fighter.CurrentPhase)</strong></div>
                <div class="attribute-card"><span>Next Milestone</span><strong>@BuildMilestoneText()</strong></div>
                <div class="attribute-card"><span>Form</span><strong>@DescribeCondition(_fighter.Form)</strong></div>
                <div class="attribute-card"><span>Energy</span><strong>@DescribeCondition(_fighter.Energy)</strong></div>
                <div class="attribute-card"><span>Sharpness</span><strong>@DescribeCondition(_fighter.Sharpness)</strong></div>
                <div class="attribute-card"><span>Morale</span><strong>@DescribeMorale(_fighter.Morale)</strong></div>
                <div class="attribute-card"><span>Camp Quality</span><strong>@DescribeCamp(_fighter.CampQuality)</strong></div>
                <div class="attribute-card"><span>Camp Focus</span><strong>@DescribeCampFocus(_fighter.CampFocus)</strong></div>
                <div class="attribute-card"><span>Weight Cut</span><strong>@DescribeCut(_fighter.WeightCutReadiness)</strong></div>
                <div class="attribute-card"><span>Injury Risk</span><strong>@DescribeRisk(_fighter.InjuryRisk)</strong></div>
                <div class="attribute-card"><span>Media Heat</span><strong>@DescribeHeat(_fighter.MediaHeat)</strong></div>
                <div class="attribute-card"><span>Reliability</span><strong>@DescribeReliability(_fighter.ReliabilityScore)</strong></div>
                <div class="attribute-card"><span>Wear</span><strong>@DescribeWear(_fighter.DamageMiles)</strong></div>
                <div class="attribute-card"><span>Weight Misses</span><strong>@_fighter.WeightMissCount</strong></div>
                <div class="attribute-card"><span>Camp Withdrawals</span><strong>@_fighter.CampWithdrawalCount</strong></div>
            </div>

            @if (CanAdjustCampFocus())
            {
                <div class="table-toolbar" style="margin-top:18px;">
                    <div class="toolbar-title">Camp Focus</div>
                    <div class="toolbar-subtitle">Shape the prep toward a clear edge before fight week.</div>
                </div>

                <div class="button-row" style="gap:10px; flex-wrap:wrap;">
                    @foreach (var option in CampFocusOptions)
                    {
                        <button class="btn-secondary @(IsCampFocusSelected(option.Key) ? "camp-focus-btn-active" : "")"
                                disabled="@_busyCampFocus"
                                @onclick="() => SetCampFocusAsync(option.Key)">
                            @option.Label
                        </button>
                    }
                </div>

                <div class="muted-text" style="margin-top:10px;">@BuildCampFocusSummary()</div>

                @if (HasCampRecommendation())
                {
                    <div class="meta-box" style="margin-top:14px;">
                        <div class="meta-label">Staff Recommendation</div>
                        <div class="meta-value">@DescribeCampFocus(_fighter!.CampRecommendationFocus)</div>
                        <div class="muted-text" style="margin-top:8px;">@_fighter!.CampRecommendationReason</div>
                        @if (!string.IsNullOrWhiteSpace(_fighter!.ScheduledOpponentStyleSummary))
                        {
                            <div class="muted-text" style="margin-top:6px;">Opponent read: @_fighter!.ScheduledOpponentStyleSummary</div>
                        }

                        @if (!IsCampFocusSelected(_fighter!.CampRecommendationFocus!))
                        {
                            <div class="button-row" style="margin-top:12px;">
                                <button class="btn-secondary"
                                        disabled="@_busyCampFocus"
                                        @onclick="UseStaffCampReadAsync">
                                    Use staff read
                                </button>
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_campFocusStatus))
                {
                    <div class="muted-text" style="margin-top:8px;">@_campFocusStatus</div>
                }
            }

            @if (!string.IsNullOrWhiteSpace(_fighter.LatestPrepNote))
            {
                <div class="meta-box" style="margin-top:16px;">
                    <div class="meta-label">Latest Prep Note</div>
                    <div class="meta-value">@_fighter.LatestPrepNote</div>
                </div>
            }
        </section>

        <section class="panel-card">
            <div class="table-toolbar">
                <div class="toolbar-title">Personality</div>
                <div class="toolbar-subtitle">How this fighter is likely to behave over a career, not just in a fight</div>
            </div>

            <div class="attribute-grid">
                <div class="attribute-card"><span>Ambition</span><strong>@DescribePersonality(_fighter.Ambition)</strong></div>
                <div class="attribute-card"><span>Discipline</span><strong>@DescribePersonality(_fighter.Discipline)</strong></div>
                <div class="attribute-card"><span>Risk Profile</span><strong>@DescribeRiskMindset(_fighter.RiskTolerance)</strong></div>
                <div class="attribute-card"><span>Stability</span><strong>@DescribePersonality(_fighter.Stability)</strong></div>
                <div class="attribute-card"><span>Showmanship</span><strong>@DescribeShowmanship(_fighter.Showmanship)</strong></div>
            </div>
        </section>

        <section class="panel-card">
            <div class="table-toolbar">
                <div class="toolbar-title">Legacy</div>
                <div class="toolbar-subtitle">What the career already says about this fighter</div>
            </div>

            @if (_fighter.LegacyTags.Count == 0)
            {
                <div class="muted-text">Legacy is still being written.</div>
            }
            else
            {
                <div class="dashboard-list">
                    @foreach (var tag in _fighter.LegacyTags)
                    {
                        <div class="dashboard-list-item">
                            <strong>@FormatLegacyTag(tag.TagCode)</strong>
                            <div class="muted-text">@tag.Summary</div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel-card">
            <div class="table-toolbar">
                <div class="toolbar-title">Active Storylines</div>
                <div class="toolbar-subtitle">Narratives currently orbiting this fighter</div>
            </div>

            @if (_fighter.Storylines.Count == 0)
            {
                <div class="muted-text">No active storylines yet.</div>
            }
            else
            {
                <div class="dashboard-list">
                    @foreach (var story in _fighter.Storylines)
                    {
                        <div class="dashboard-list-item">
                            <strong>@story.Headline</strong>
                            <div class="muted-text">@story.Body</div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="panel-card">
            <div class="table-toolbar">
                <div class="toolbar-title">Career Stats</div>
                <div class="toolbar-subtitle">Finishes and event-stage appearances</div>
            </div>

            <div class="attribute-grid">
                <div class="attribute-card"><span>KO Wins</span><strong>@_fighter.KOWins</strong></div>
                <div class="attribute-card"><span>Sub Wins</span><strong>@_fighter.SubWins</strong></div>
                <div class="attribute-card"><span>Decision Wins</span><strong>@_fighter.DecWins</strong></div>
                @if (string.Equals(_fighter.CareerStage, "Amateur", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="attribute-card"><span>Amateur Wins</span><strong>@_fighter.AmateurWins</strong></div>
                    <div class="attribute-card"><span>Amateur Losses</span><strong>@_fighter.AmateurLosses</strong></div>
                    <div class="attribute-card"><span>Amateur Draws</span><strong>@_fighter.AmateurDraws</strong></div>
                }
                <div class="attribute-card"><span>Finish Rate</span><strong>@_fighter.FinishRate.ToString("0.0")%</strong></div>
                <div class="attribute-card"><span>Title Fights</span><strong>@_fighter.TitleFightAppearances</strong></div>
                <div class="attribute-card"><span>Main Card</span><strong>@_fighter.MainCardAppearances</strong></div>
                <div class="attribute-card"><span>Main Events</span><strong>@_fighter.MainEventAppearances</strong></div>
                <div class="attribute-card"><span>Co-Main Events</span><strong>@_fighter.CoMainEventAppearances</strong></div>
            </div>
        </section>

        <section class="panel-card">
            <div class="table-toolbar">
                <div class="toolbar-title">Recent Fight History</div>
                <div class="toolbar-subtitle">@_history.Count fights</div>
            </div>

            @if (_history.Count == 0)
            {
                <div class="muted-text">No fight history found.</div>
            }
            else
            {
                <table class="fighters-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Opponent</th>
                            <th>Result</th>
                            <th>Method</th>
                            <th>Promotion</th>
                            <th>Event</th>
                            <th>Title</th>
                            <th>Eliminator</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _history)
                        {
                            <tr>
                                <td>@item.Date</td>
                                <td>@item.Opponent</td>
                                <td>
                                    <span class="result-pill @(item.Result == "W" ? "win" : "loss")">@item.Result</span>
                                </td>
                                <td>@item.Method</td>
                                <td>@item.Promotion</td>
                                <td>@(item.EventName ?? "-")</td>
                                <td>@(item.IsTitle ? "Yes" : "No")</td>
                                <td>@(item.IsTitleEliminator ? "Yes" : "No")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>
    </div>
}

@code {
    [Parameter] public int fighterId { get; set; }

    private FighterProfile? _fighter;
    private List<FightHistoryItem> _history = new();
    private bool _loading = true;
    private bool _isManaged;
    private bool _busyScouting;
    private bool _busyCampFocus;
    private string? _campFocusStatus;
    private string? _actionStatus;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _loading = true;
            _error = null;

            var result = await FightProfileReadService.LoadAsync(fighterId, 20);
            _fighter = result.Fighter;
            _history = result.History.ToList();

            _isManaged = _fighter?.IsManagedByPlayer ?? false;
            _actionStatus = null;
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SignCurrentFighterAsync()
    {
        try
        {
            if (_fighter is null || _isManaged)
                return;

            var result = await FighterActionService.AttemptSignAsync(_fighter.Id);
            if (!result.Success)
            {
                _error = result.Message;
                return;
            }

            _isManaged = true;
            _actionStatus = result.Message;
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
    }

    private string GetSignButtonClass()
    {
        if (_fighter is null)
            return "btn-sign";

        if (string.Equals(_fighter.ContractStatus, "FreeAgent", StringComparison.OrdinalIgnoreCase))
            return "btn-sign";

        return "btn-sign-alt";
    }

    private string GetSignButtonText()
    {
        if (_fighter is null)
            return "Sign fighter";

        if (string.Equals(_fighter.ContractStatus, "FreeAgent", StringComparison.OrdinalIgnoreCase))
            return "Sign fighter";

        return "Approach fighter";
    }

    private async Task StartScoutAsync()
    {
        try
        {
            if (_fighter is null)
                return;

            _busyScouting = true;
            await RosterService.StartScoutAsync(_fighter.Id);

            var result = await FightProfileReadService.LoadAsync(fighterId, 20);
            _fighter = result.Fighter;
            _history = result.History.ToList();
            _isManaged = _fighter?.IsManagedByPlayer ?? false;
            _actionStatus = "Scout assignment started.";
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busyScouting = false;
        }
    }

    private async Task SetCampFocusAsync(string focus)
    {
        try
        {
            if (_fighter is null || !CanAdjustCampFocus())
                return;

            _busyCampFocus = true;
            _campFocusStatus = null;

            var result = await FighterActionService.SetCampFocusAsync(_fighter.Id, focus);
            if (!result.Success)
            {
                _campFocusStatus = result.Message;
                return;
            }

            _campFocusStatus = result.Message;
            var refreshed = await FightProfileReadService.LoadAsync(fighterId, 20);
            _fighter = refreshed.Fighter;
            _history = refreshed.History.ToList();
            _isManaged = _fighter?.IsManagedByPlayer ?? false;
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busyCampFocus = false;
        }
    }

    private Task UseStaffCampReadAsync()
    {
        if (_fighter is null || string.IsNullOrWhiteSpace(_fighter.CampRecommendationFocus))
            return Task.CompletedTask;

        return SetCampFocusAsync(_fighter.CampRecommendationFocus);
    }

    private async Task SeekFightAsync()
    {
        try
        {
            if (_fighter is null || !_isManaged)
                return;

            var result = await FighterActionService.SeekFightAsync(_fighter.Id);
            _actionStatus = result.Message;
            if (!result.Success)
                return;

            var refreshed = await FightProfileReadService.LoadAsync(fighterId, 20);
            _fighter = refreshed.Fighter;
            _history = refreshed.History.ToList();
            _isManaged = _fighter?.IsManagedByPlayer ?? false;
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
    }

    private bool CanScout()
    {
        if (_fighter is null || _isManaged)
            return false;

        return !string.Equals(_fighter.ScoutStatus, "Scouting", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(_fighter.ScoutStatus, "Known", StringComparison.OrdinalIgnoreCase);
    }

    private bool CanAdjustCampFocus()
    {
        if (_fighter is null || !_isManaged || !_fighter.IsBooked)
            return false;

        return !string.Equals(_fighter.CurrentPhase, "Fight Night", StringComparison.OrdinalIgnoreCase)
            && !string.Equals(_fighter.CurrentPhase, "Medical Suspension", StringComparison.OrdinalIgnoreCase);
    }

    private bool CanSeekFight()
    {
        if (_fighter is null || !_isManaged || _fighter.IsBooked)
            return false;

        return !string.Equals(_fighter.ContractStatus, "FreeAgent", StringComparison.OrdinalIgnoreCase)
            && _fighter.PromotionId is not null;
    }

    private bool HasCampRecommendation()
        => _fighter is not null
           && !string.IsNullOrWhiteSpace(_fighter.CampRecommendationFocus)
           && !string.IsNullOrWhiteSpace(_fighter.CampRecommendationReason);

    private string BuildAvailabilityText()
    {
        if (_fighter is null)
            return "-";

        if (_fighter.MedicalSuspensionWeeksRemaining > 0)
            return $"Medical suspension: {_fighter.MedicalSuspensionWeeksRemaining}w";

        if (_fighter.InjuryWeeksRemaining > 0)
            return $"Injured: {_fighter.InjuryWeeksRemaining}w";

        if (_fighter.WeeksUntilAvailable > 0)
            return $"Recovering: {_fighter.WeeksUntilAvailable}w";

        return "Available";
    }

    private string BuildMilestoneText()
    {
        if (_fighter is null || string.IsNullOrWhiteSpace(_fighter.NextMilestoneType))
            return "None";

        if (string.IsNullOrWhiteSpace(_fighter.NextMilestoneDate))
            return _fighter.NextMilestoneType;

        return $"{_fighter.NextMilestoneType} · {_fighter.NextMilestoneDate}";
    }

    private string BuildScheduledFightText()
    {
        if (_fighter is null)
            return "-";

        if (_fighter.IsBooked && !string.IsNullOrWhiteSpace(_fighter.ScheduledEventName))
        {
            var opponent = string.IsNullOrWhiteSpace(_fighter.ScheduledOpponentName)
                ? "TBD"
                : _fighter.ScheduledOpponentName;

            return $"{_fighter.ScheduledEventName} vs {opponent}";
        }

        return "None booked";
    }

    private string BuildHeadlineSummary()
    {
        if (_fighter is null)
            return string.Empty;

        if (_fighter.IsChampion)
            return $"{_fighter.Name} is carrying divisional gravity right now.";

        if (_fighter.RankPosition is <= 3 and > 0)
            return $"{_fighter.Name} is deep in the title picture and every next move matters.";

        if (_fighter.IsBooked && !string.IsNullOrWhiteSpace(_fighter.ScheduledOpponentName))
            return $"{_fighter.Name} is pointed at {_fighter.ScheduledOpponentName} and camp decisions matter now.";

        return $"{_fighter.Name} is moving through the live MMA ecosystem with pressure building around the next step.";
    }

    private string BuildIdentitySummary()
    {
        if (_fighter is null)
            return string.Empty;

        return $"{_fighter.BaseStyle} · {_fighter.TacticalStyle} · Finish rate {_fighter.FinishRate:0.0}%";
    }

