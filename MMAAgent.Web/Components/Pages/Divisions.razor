@page "/divisions"
@rendermode InteractiveServer
@using MMAAgent.Web.Models
@using MMAAgent.Web.Services
@inject WebDivisionsService DivisionsService
@inject WebDivisionActionService DivisionActionService

<PageTitle>Divisions - MMA Agent</PageTitle>

<div class="page-header">
    <div>
        <h1>Divisions</h1>
        <p class="muted-text">Champion, contender queue, rivalry heat and the political pressure you can apply to move your fighters up.</p>
    </div>
</div>

@if (_error is not null)
{
    <div class="panel-card error-panel">@_error</div>
}
else if (_loading)
{
    <div class="panel-card">Loading divisions...</div>
}
else if (_groups.Count == 0)
{
    <div class="panel-card">No division picture available yet.</div>
}
else
{
    <div class="dashboard-grid">
        @foreach (var group in _groups)
        {
            <section class="panel-card">
                <div class="table-toolbar">
                    <div class="toolbar-title">
                        <a class="fighter-link" href="@($"/promotions/{group.PromotionId}")">@group.PromotionName</a>
                    </div>
                    <div class="toolbar-subtitle">@group.Divisions.Count divisions tracked</div>
                </div>

                <div class="dashboard-list">
                    @foreach (var division in group.Divisions)
                    {
                        <article class="dashboard-list-item division-battle-card">
                            <div class="division-battle-top">
                                <strong>@division.WeightClass</strong>
                                @if (!string.IsNullOrWhiteSpace(division.UpcomingStakes))
                                {
                                    <span class="message-badge">@division.UpcomingStakes</span>
                                }
                            </div>

                            <div class="muted-text">
                                Champion:
                                @if (division.ChampionId is int championId)
                                {
                                    <a class="fighter-link" href="@($"/fighters/{championId}")">@division.ChampionName</a>
                                }
                                else
                                {
                                    @division.ChampionName
                                }
                            </div>

                            @if (division.NextContenders.Count > 0)
                            {
                                <div class="muted-text">
                                    Queue:
                                    @for (var i = 0; i < division.NextContenders.Count; i++)
                                    {
                                        var contender = division.NextContenders[i];
                                        <span>
                                            #@contender.QueueRank
                                            <a class="fighter-link" href="@($"/fighters/{contender.FighterId}")">@contender.FighterName</a>
                                            @if (i < division.NextContenders.Count - 1)
                                            {
                                                <span> · </span>
                                            }
                                        </span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(division.RivalryHeadline))
                            {
                                <div class="muted-text">Rivalry: @division.RivalryHeadline</div>
                            }

                            @if (division.ManagedContender is not null)
                            {
                                <div class="division-managed-box">
                                    <strong>Your fighter in the picture</strong>
                                    <div class="muted-text">
                                        #@division.ManagedContender.QueueRank
                                        <a class="fighter-link" href="@($"/fighters/{division.ManagedContender.FighterId}")">@division.ManagedContender.FighterName</a>
                                    </div>

                                    <div class="button-row" style="margin-top:10px; gap:10px; flex-wrap:wrap;">
                                        <button class="btn-secondary"
                                                disabled="@_busyDivisionAction"
                                                @onclick="() => PushManagedFighterAsync(group.PromotionId, division.WeightClass, division.ManagedContender.FighterId)">
                                            Push fighter
                                        </button>
                                        <button class="btn-secondary"
                                                disabled="@_busyDivisionAction"
                                                @onclick="() => RequestEliminatorAsync(group.PromotionId, division.WeightClass, division.ManagedContender.FighterId)">
                                            Request eliminator
                                        </button>
                                        <button class="btn-primary"
                                                disabled="@_busyDivisionAction"
                                                @onclick="() => RequestTitleShotAsync(group.PromotionId, division.WeightClass, division.ManagedContender.FighterId)">
                                            Request title shot
                                        </button>
                                    </div>
                                </div>
                            }

                            @if (division.RecentChampions.Count > 0)
                            {
                                <div class="division-history-row">
                                    <span class="meta-label">Recent champions</span>
                                    <div class="muted-text">
                                        @for (var i = 0; i < division.RecentChampions.Count; i++)
                                        {
                                            var champ = division.RecentChampions[i];
                                            <span>
                                                <a class="fighter-link" href="@($"/fighters/{champ.FighterId}")">@champ.FighterName</a>
                                                @if (!string.IsNullOrWhiteSpace(champ.FightDate))
                                                {
                                                    <span> (@champ.FightDate)</span>
                                                }
                                                @if (i < division.RecentChampions.Count - 1)
                                                {
                                                    <span> · </span>
                                                }
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </article>
                    }
                </div>
            </section>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_status))
    {
        <div class="panel-card" style="margin-top:20px;">@_status</div>
    }
}

@code {
    private List<DivisionPromotionGroupVm> _groups = new();
    private bool _loading = true;
    private bool _busyDivisionAction;
    private string? _error;
    private string? _status;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task RequestTitleShotAsync(int promotionId, string weightClass, int fighterId)
        => await RunDivisionActionAsync(() => DivisionActionService.RequestTitleShotAsync(promotionId, weightClass, fighterId));

    private async Task RequestEliminatorAsync(int promotionId, string weightClass, int fighterId)
        => await RunDivisionActionAsync(() => DivisionActionService.RequestEliminatorAsync(promotionId, weightClass, fighterId));

    private async Task PushManagedFighterAsync(int promotionId, string weightClass, int fighterId)
        => await RunDivisionActionAsync(() => DivisionActionService.PushManagedFighterAsync(promotionId, weightClass, fighterId));

    private async Task RunDivisionActionAsync(Func<Task<MMAAgent.Application.Abstractions.ServiceResult>> action)
    {
        try
        {
            _busyDivisionAction = true;
            _status = null;
            var result = await action();
            _status = result.Message;
            if (result.Success)
            {
                await ReloadAsync();
            }
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busyDivisionAction = false;
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            _loading = true;
            _error = null;
            _groups = (await DivisionsService.LoadAsync()).ToList();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _loading = false;
        }
    }
}
