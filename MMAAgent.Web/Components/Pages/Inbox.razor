@page "/inbox"
@rendermode InteractiveServer
@implements IDisposable
@using MMAAgent.Web.Models
@using MMAAgent.Web.Services
@using MMAAgent.Application.Abstractions

@inject IFightOfferResponseService FightOfferResponseService
@inject IContractOfferResponseService ContractOfferResponseService
@inject WebInboxService InboxService
@inject InboxStatusService InboxStatusService

<PageTitle>Inbox - MMA Agent</PageTitle>

<div class="page-header">
    <div>
        <h1>Inbox</h1>
        <p class="muted-text">A single command inbox for messages, live decisions and negotiation traffic.</p>
    </div>

    <div class="button-row" style="flex-wrap:wrap;">
        <select class="text-input" @bind="_listFilter">
            <option value="all">All traffic</option>
            <option value="messages">Messages</option>
            <option value="decisions">Live decisions</option>
            <option value="fightoffers">Fight offers</option>
            <option value="contractoffers">Contract offers</option>
        </select>

        <select class="text-input" @bind="_messageType">
            <option value="">All message types</option>
            @foreach (var item in _messageTypes)
            {
                <option value="@item">@item</option>
            }
        </select>

        <select class="text-input" @bind="_visibilityFilter">
            <option value="active">Active only</option>
            <option value="archived">Archived only</option>
            <option value="all">All</option>
        </select>

        <button class="btn-secondary" @onclick="ReloadAsync" disabled="@_busy">Refresh</button>
        <button class="btn-secondary" @onclick="MarkAllReadAsync" disabled="@_busy">Mark all read</button>
        <button class="btn-secondary" @onclick="ArchiveReadAsync" disabled="@_busy">Archive read</button>
        <button class="btn-secondary" @onclick="DeleteReadAsync" disabled="@_busy">Delete read</button>
        <button class="btn-secondary" @onclick="DeleteProcessedFightOffersAsync" disabled="@(_busy || _fightOffers.All(x => IsPending(x.Status)))">Clean fight offers</button>
        <button class="btn-secondary" @onclick="DeleteProcessedContractOffersAsync" disabled="@(_busy || _contractOffers.All(x => IsPending(x.Status)))">Clean contract offers</button>
    </div>
</div>

@if (_error is not null)
{
    <div class="panel-card error-panel">@_error</div>
}
else if (_loading)
{
    <div class="panel-card">Loading inbox...</div>
}
else
{
    <section class="panel-card inbox-mail-shell">
        <aside class="inbox-mail-sidebar">
            <div class="inbox-mail-sidebar-head">
                <div>
                    <div class="toolbar-title">Mailroom</div>
                    <div class="toolbar-subtitle">@_surfaceItems.Count threads visible</div>
                </div>

                <div class="inbox-mail-pills">
                    <span class="message-badge">@_messages.Count(x => !x.IsRead) unread</span>
                    <span class="message-badge">@_decisions.Count decisions</span>
                </div>
            </div>

            @if (_surfaceItems.Count == 0)
            {
                <div class="inbox-mail-empty">
                    <div class="toolbar-title">Quiet inbox</div>
                    <div class="muted-text">No traffic matches the current filters.</div>
                </div>
            }
            else
            {
                <div class="inbox-mail-list">
                    @foreach (var item in _surfaceItems)
                    {
                        <button type="button"
                                class="inbox-mail-item @(IsSelected(item) ? "selected" : "") @(item.EmphasisClass)"
                                @onclick="() => SelectItemAsync(item)"
                                disabled="@_busy">
                            <div class="inbox-mail-item-top">
                                <span class="inbox-mail-item-type">@item.TypeLabel</span>
                                @if (!string.IsNullOrWhiteSpace(item.DateLabel))
                                {
                                    <span class="message-date">@item.DateLabel</span>
                                }
                            </div>

                            <div class="inbox-mail-item-title">@item.Title</div>

                            @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                            {
                                <div class="inbox-mail-item-subtitle">@item.Subtitle</div>
                            }

                            @if (!string.IsNullOrWhiteSpace(item.Preview))
                            {
                                <div class="message-body-preview">@item.Preview</div>
                            }

                            <div class="inbox-mail-item-tags">
                                @foreach (var tag in item.Tags)
                                {
                                    <span class="message-badge">@tag</span>
                                }
                            </div>
                        </button>
                    }
                </div>
            }
        </aside>

        <section class="inbox-mail-reader">
            @if (_selectedItem is null)
            {
                <div class="inbox-reader-empty">
                    <div class="toolbar-title">Select a thread</div>
                    <div class="muted-text">Choose a message, offer or live decision from the left to inspect it here.</div>
                </div>
            }
            else if (_selectedItem.Kind == InboxSurfaceKind.Message && SelectedMessage is not null)
            {
                <div class="inbox-reader-head">
                    <div>
                        <div class="toolbar-title">@SelectedMessage.Subject</div>
                        <div class="toolbar-subtitle">@SelectedMessage.CreatedDate · @SelectedMessage.MessageType</div>
                    </div>

                    <div class="button-row" style="flex-wrap:wrap;">
                        @if (!SelectedMessage.IsRead)
                        {
                            <button class="btn-secondary" disabled="@_busy" @onclick="MarkSelectedReadAsync">Mark read</button>
                        }

                        @if (!SelectedMessage.IsArchived)
                        {
                            <button class="btn-secondary" disabled="@_busy" @onclick="ArchiveSelectedAsync">Archive</button>
                        }
                        else
                        {
                            <button class="btn-secondary" disabled="@_busy" @onclick="RestoreSelectedAsync">Restore</button>
                        }

                        <button class="btn-secondary" disabled="@_busy" @onclick="DeleteSelectedAsync">Delete</button>
                    </div>
                </div>

                <div class="inbox-reader-body">
                    <div class="inbox-reader-meta-row">
                        <span class="message-badge">@SelectedMessage.MessageType</span>
                        @if (!SelectedMessage.IsRead)
                        {
                            <span class="message-badge">Unread</span>
                        }
                        @if (SelectedMessage.IsArchived)
                        {
                            <span class="message-badge">Archived</span>
                        }
                    </div>

                    <div class="message-full-body">@SelectedMessage.Body</div>
                </div>
            }
            else if (_selectedItem.Kind == InboxSurfaceKind.Decision && SelectedDecision is not null)
            {
                <div class="inbox-reader-head">
                    <div>
                        <div class="toolbar-title">@SelectedDecision.Headline</div>
                        <div class="toolbar-subtitle">@SelectedDecision.CreatedDate · @SelectedDecision.DecisionType</div>
                    </div>

                    <div class="button-row" style="flex-wrap:wrap;">
                        @if (SelectedDecision.FighterId is int decisionFighterId)
                        {
                            <a class="btn-secondary" href="@($"/fighters/{decisionFighterId}")">Open fighter</a>
                        }
                    </div>
                </div>

                <div class="inbox-reader-body">
                    <div class="inbox-reader-meta-row">
                        <span class="message-badge">Live decision</span>
                        <span class="message-badge">@SelectedDecision.DecisionType</span>
                    </div>

                    <div class="message-full-body">@SelectedDecision.Body</div>

                    @if (!string.IsNullOrWhiteSpace(SelectedDecision.OptionADescription))
                    {
                        <div class="inbox-choice-card">
                            <div class="inbox-choice-title">@SelectedDecision.OptionALabel</div>
                            <div class="muted-text">@SelectedDecision.OptionADescription</div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(SelectedDecision.OptionBDescription))
                    {
                        <div class="inbox-choice-card">
                            <div class="inbox-choice-title">@SelectedDecision.OptionBLabel</div>
                            <div class="muted-text">@SelectedDecision.OptionBDescription</div>
                        </div>
                    }

                    <div class="button-row" style="margin-top:18px; flex-wrap:wrap;">
                        <button class="btn-primary"
                                disabled="@_busy"
                                @onclick="() => ResolveDecisionAsync(SelectedDecision.Id, SelectedDecision.OptionAKey)">
                            @SelectedDecision.OptionALabel
                        </button>

                        <button class="btn-secondary"
                                disabled="@_busy"
                                @onclick="() => ResolveDecisionAsync(SelectedDecision.Id, SelectedDecision.OptionBKey)">
                            @SelectedDecision.OptionBLabel
                        </button>
                    </div>
                </div>
            }
            else if (_selectedItem.Kind == InboxSurfaceKind.FightOffer && SelectedFightOffer is not null)
            {
                <div class="inbox-reader-head">
                    <div>
                        <div class="toolbar-title">@SelectedFightOffer.FighterName vs @SelectedFightOffer.OpponentName</div>
                        <div class="toolbar-subtitle">@SelectedFightOffer.PromotionName · @SelectedFightOffer.Status</div>
                    </div>

                    <div class="button-row" style="flex-wrap:wrap;">
                        <a class="btn-secondary" href="@($"/fighters/{SelectedFightOffer.FighterId}")">Open fighter</a>
                        <button class="btn-secondary" disabled="@_busy" @onclick="() => DeleteFightOfferAsync(SelectedFightOffer.OfferId)">Delete</button>
                    </div>
                </div>

                <div class="inbox-reader-body">
                    <div class="inbox-reader-meta-grid">
                        <div class="meta-box"><div class="meta-label">Promotion</div><div class="meta-value">@SelectedFightOffer.PromotionName</div></div>
                        <div class="meta-box"><div class="meta-label">Purse</div><div class="meta-value">@SelectedFightOffer.Purse</div></div>
                        <div class="meta-box"><div class="meta-label">Win Bonus</div><div class="meta-value">@SelectedFightOffer.WinBonus</div></div>
                        <div class="meta-box"><div class="meta-label">Weeks Until Fight</div><div class="meta-value">@SelectedFightOffer.WeeksUntilFight</div></div>
                        <div class="meta-box"><div class="meta-label">Camp Weeks</div><div class="meta-value">@SelectedFightOffer.CampWeeksOffered</div></div>
                        <div class="meta-box"><div class="meta-label">Status</div><div class="meta-value">@SelectedFightOffer.Status</div></div>
                    </div>

                    <div class="inbox-reader-meta-row">
                        @if (SelectedFightOffer.IsTitleFight)
                        {
                            <span class="message-badge">Title Fight</span>
                        }
                        @if (SelectedFightOffer.IsTitleEliminator)
                        {
                            <span class="message-badge">Title Eliminator</span>
                        }
                        @if (SelectedFightOffer.IsShortNotice)
                        {
                            <span class="message-badge">Short Notice</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SelectedFightOffer.Notes))
                    {
                        <div class="message-full-body">@SelectedFightOffer.Notes</div>
                    }

                    <div class="button-row" style="margin-top:18px; flex-wrap:wrap;">
                        <button class="btn-primary"
                                disabled="@(_busy || !IsPending(SelectedFightOffer.Status))"
                                @onclick="() => AcceptFightOfferAsync(SelectedFightOffer.OfferId)">
                            Accept
                        </button>

                        <button class="btn-secondary"
                                disabled="@(_busy || !IsPending(SelectedFightOffer.Status))"
                                @onclick="() => RejectFightOfferAsync(SelectedFightOffer.OfferId)">
                            Reject
                        </button>
                    </div>
                </div>
            }
            else if (_selectedItem.Kind == InboxSurfaceKind.ContractOffer && SelectedContractOffer is not null)
            {
                <div class="inbox-reader-head">
                    <div>
                        <div class="toolbar-title">@SelectedContractOffer.FighterName · @SelectedContractOffer.PromotionName</div>
                        <div class="toolbar-subtitle">@SelectedContractOffer.SourceType · @SelectedContractOffer.Status</div>
                    </div>

                    <div class="button-row" style="flex-wrap:wrap;">
                        <a class="btn-secondary" href="@($"/fighters/{SelectedContractOffer.FighterId}")">Open fighter</a>
                        <button class="btn-secondary" disabled="@_busy" @onclick="() => DeleteContractOfferAsync(SelectedContractOffer.Id)">Delete</button>
                    </div>
                </div>

                <div class="inbox-reader-body">
                    <div class="inbox-reader-meta-grid">
                        <div class="meta-box"><div class="meta-label">Promotion</div><div class="meta-value">@SelectedContractOffer.PromotionName</div></div>
                        <div class="meta-box"><div class="meta-label">Fights</div><div class="meta-value">@SelectedContractOffer.OfferedFights</div></div>
                        <div class="meta-box"><div class="meta-label">Base Purse</div><div class="meta-value">@SelectedContractOffer.BasePurse</div></div>
                        <div class="meta-box"><div class="meta-label">Win Bonus</div><div class="meta-value">@SelectedContractOffer.WinBonus</div></div>
                        <div class="meta-box"><div class="meta-label">Signing Bonus</div><div class="meta-value">@SelectedContractOffer.SigningBonus</div></div>
                        <div class="meta-box"><div class="meta-label">Exclusivity</div><div class="meta-value">@SelectedContractOffer.ExclusivityType</div></div>
                        <div class="meta-box"><div class="meta-label">Reply Window</div><div class="meta-value">@SelectedContractOffer.WeeksToRespond week(s)</div></div>
                        <div class="meta-box"><div class="meta-label">Status</div><div class="meta-value">@SelectedContractOffer.Status</div></div>
                    </div>

                    <div class="inbox-reader-meta-row">
                        <span class="message-badge">@SelectedContractOffer.SourceType</span>
                        @if (!string.IsNullOrWhiteSpace(SelectedContractOffer.Recommendation))
                        {
                            <span class="message-badge">Recommended: @SelectedContractOffer.Recommendation</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SelectedContractOffer.Notes))
                    {
                        <div class="message-full-body">@SelectedContractOffer.Notes</div>
                    }

                    <div class="button-row" style="margin-top:18px; flex-wrap:wrap;">
                        <button class="btn-primary"
                                disabled="@(_busy || !IsPending(SelectedContractOffer.Status))"
                                @onclick="() => AcceptContractOfferAsync(SelectedContractOffer.Id)">
                            Accept as-is
                        </button>

                        <button class="btn-secondary"
                                disabled="@(_busy || !IsPending(SelectedContractOffer.Status))"
                                @onclick="() => AcceptContractForMoneyAsync(SelectedContractOffer.Id)">
                            Push money
                        </button>

                        <button class="btn-secondary"
                                disabled="@(_busy || !IsPending(SelectedContractOffer.Status))"
                                @onclick="() => AcceptContractForBonusAsync(SelectedContractOffer.Id)">
                            Push bonus
                        </button>

                        <button class="btn-secondary"
                                disabled="@(_busy || !IsPending(SelectedContractOffer.Status))"
                                @onclick="() => AcceptContractForSecurityAsync(SelectedContractOffer.Id)">
                            Push security
                        </button>

                        <button class="btn-secondary"
                                disabled="@(_busy || !IsPending(SelectedContractOffer.Status))"
                                @onclick="() => AcceptContractForExposureAsync(SelectedContractOffer.Id)">
                            Push exposure
                        </button>

                        <button class="btn-secondary"
                                disabled="@(_busy || !IsPending(SelectedContractOffer.Status))"
                                @onclick="() => RejectContractOfferAsync(SelectedContractOffer.Id)">
                            Reject
                        </button>
                    </div>
                </div>
            }
        </section>
    </section>
}

@if (!string.IsNullOrWhiteSpace(_status))
{
    <div class="muted-text" style="margin-top:14px;">@_status</div>
}

@code {
    private List<InboxMessageVm> _messages = new();
    private List<FightOfferVm> _fightOffers = new();
    private List<ContractOfferVm> _contractOffers = new();
    private List<DecisionEventVm> _decisions = new();

    private InboxMessageVm? SelectedMessage;
    private FightOfferVm? SelectedFightOffer;
    private ContractOfferVm? SelectedContractOffer;
    private DecisionEventVm? SelectedDecision;
    private InboxSurfaceItem? _selectedItem;
    private List<InboxSurfaceItem> _surfaceItems = new();

    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _status;

    private string _messageType = "";
    private string _visibilityFilter = "active";
    private string _listFilter = "all";
    private List<string> _messageTypes = new();

    protected override async Task OnInitializedAsync()
    {
        InboxStatusService.Changed += HandleInboxStatusChanged;
        await InboxStatusService.EnsureStartedAsync();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _loading = true;
            _busy = true;
            _error = null;
            _status = null;

            var includeArchived = _visibilityFilter is "archived" or "all";
            var archivedOnly = _visibilityFilter == "archived";

            var result = await InboxService.LoadAsync(_messageType, includeArchived, archivedOnly);

            _messages = result.Messages.ToList();
            _fightOffers = result.Offers.ToList();
            _contractOffers = result.ContractOffers.ToList();
            _decisions = result.Decisions.ToList();

            _messageTypes = _messages
                .Select(x => x.MessageType)
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct()
                .OrderBy(x => x)
                .ToList();

            RebuildSurfaceItems();
            ReselectOrFallback();

            await InboxStatusService.RefreshAsync();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _loading = false;
            _busy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void RebuildSurfaceItems()
    {
        var items = new List<InboxSurfaceItem>();

        if (_listFilter is "all" or "decisions")
        {
            items.AddRange(_decisions.Select(x => new InboxSurfaceItem(
                InboxSurfaceKind.Decision,
                x.Id,
                x.Headline,
                x.DecisionType,
                x.Body,
                x.CreatedDate,
                false,
                new[] { "Live", x.DecisionType },
                "inbox-tone-decision")));
        }

        if (_listFilter is "all" or "fightoffers")
        {
            items.AddRange(_fightOffers.Select(x => new InboxSurfaceItem(
                InboxSurfaceKind.FightOffer,
                x.OfferId,
                $"{x.FighterName} vs {x.OpponentName}",
                x.PromotionName,
                BuildFightOfferPreview(x),
                $"Fight in {x.WeeksUntilFight}w",
                false,
                BuildFightOfferTags(x),
                x.IsShortNotice ? "inbox-tone-urgent" : "inbox-tone-offer")));
        }

        if (_listFilter is "all" or "contractoffers")
        {
            items.AddRange(_contractOffers.Select(x => new InboxSurfaceItem(
                InboxSurfaceKind.ContractOffer,
                x.Id,
                $"{x.FighterName} · {x.PromotionName}",
                x.SourceType,
                BuildContractOfferPreview(x),
                $"{x.WeeksToRespond}w to reply",
                false,
                BuildContractOfferTags(x),
                "inbox-tone-contract")));
        }

        if (_listFilter is "all" or "messages")
        {
            items.AddRange(_messages.Select(x => new InboxSurfaceItem(
                InboxSurfaceKind.Message,
                x.Id,
                x.Subject,
                x.MessageType,
                x.Body,
                x.CreatedDate,
                !x.IsRead,
                BuildMessageTags(x),
                !x.IsRead ? "inbox-tone-unread" : "inbox-tone-message")));
        }

        _surfaceItems = items
            .OrderByDescending(x => x.Kind == InboxSurfaceKind.Decision)
            .ThenByDescending(x => x.IsUnread)
            .ThenByDescending(x => x.Id)
            .ToList();
    }

    private void ReselectOrFallback()
    {
        if (_selectedItem is not null)
        {
            _selectedItem = _surfaceItems.FirstOrDefault(x => x.Kind == _selectedItem.Kind && x.Id == _selectedItem.Id);
        }

        _selectedItem ??= _surfaceItems.FirstOrDefault();
        SyncSelectedObjects();
    }

    private void SyncSelectedObjects()
    {
        SelectedMessage = null;
        SelectedFightOffer = null;
        SelectedContractOffer = null;
        SelectedDecision = null;

        if (_selectedItem is null)
            return;

        switch (_selectedItem.Kind)
        {
            case InboxSurfaceKind.Message:
                SelectedMessage = _messages.FirstOrDefault(x => x.Id == _selectedItem.Id);
                break;
            case InboxSurfaceKind.FightOffer:
                SelectedFightOffer = _fightOffers.FirstOrDefault(x => x.OfferId == _selectedItem.Id);
                break;
            case InboxSurfaceKind.ContractOffer:
                SelectedContractOffer = _contractOffers.FirstOrDefault(x => x.Id == _selectedItem.Id);
                break;
            case InboxSurfaceKind.Decision:
                SelectedDecision = _decisions.FirstOrDefault(x => x.Id == _selectedItem.Id);
                break;
        }
    }

    private async Task SelectItemAsync(InboxSurfaceItem item)
    {
        if (_busy)
            return;

        _selectedItem = item;
        SyncSelectedObjects();
        _status = null;
        _error = null;

        if (item.Kind == InboxSurfaceKind.Message && SelectedMessage is not null && !SelectedMessage.IsRead)
        {
            try
            {
                _busy = true;
                await InboxService.MarkMessageAsReadAsync(SelectedMessage.Id);
                await ReloadAsync();
                _selectedItem = _surfaceItems.FirstOrDefault(x => x.Kind == item.Kind && x.Id == item.Id);
                SyncSelectedObjects();
            }
            catch (Exception ex)
            {
                _error = ex.ToString();
            }
            finally
            {
                _busy = false;
            }
        }
    }

    private bool IsSelected(InboxSurfaceItem item)
        => _selectedItem is not null && _selectedItem.Kind == item.Kind && _selectedItem.Id == item.Id;

    private async Task MarkAllReadAsync()
    {
        try
        {
            _busy = true;
            _error = null;
            await InboxService.MarkAllReadAsync();
            _status = "All visible messages marked as read.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ArchiveReadAsync()
    {
        try
        {
            _busy = true;
            _error = null;
            await InboxService.ArchiveReadAsync();
            _status = "Read messages archived.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteReadAsync()
    {
        try
        {
            _busy = true;
            _error = null;
            await InboxService.DeleteReadAsync();
            _status = "Read messages deleted.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MarkSelectedReadAsync()
    {
        if (SelectedMessage is null)
            return;

        try
        {
            _busy = true;
            _error = null;
            await InboxService.MarkMessageAsReadAsync(SelectedMessage.Id);
            _status = "Message marked as read.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ArchiveSelectedAsync()
    {
        if (SelectedMessage is null)
            return;

        try
        {
            _busy = true;
            _error = null;
            await InboxService.ArchiveMessageAsync(SelectedMessage.Id);
            _status = "Message archived.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RestoreSelectedAsync()
    {
        if (SelectedMessage is null)
            return;

        try
        {
            _busy = true;
            _error = null;
            await InboxService.RestoreMessageAsync(SelectedMessage.Id);
            _status = "Message restored.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteSelectedAsync()
    {
        if (SelectedMessage is null)
            return;

        try
        {
            _busy = true;
            _error = null;
            await InboxService.DeleteMessageAsync(SelectedMessage.Id);
            _status = "Message deleted.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AcceptFightOfferAsync(int offerId)
    {
        try
        {
            _busy = true;
            _error = null;

            var result = await FightOfferResponseService.AcceptOfferAsync(offerId);
            if (!result.Success)
            {
                _error = result.Message;
                return;
            }

            _status = result.Message ?? "Fight offer accepted.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.ToString();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RejectFightOfferAsync(int offerId)
    {
        try
        {
            _busy = true;
            _error = null;

            var result = await FightOfferResponseService.RejectOfferAsync(offerId);
