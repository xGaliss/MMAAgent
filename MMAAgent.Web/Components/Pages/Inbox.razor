    private static bool IsPending(string? status)
        => string.Equals(status, "Pending", StringComparison.OrdinalIgnoreCase);

    private static string BuildFightOfferPreview(FightOfferVm offer)
        => $"Purse {offer.Purse} · Bonus {offer.WinBonus} · Camp {offer.CampWeeksOffered}w";

    private static IReadOnlyList<string> BuildFightOfferTags(FightOfferVm offer)
    {
        var tags = new List<string>();
        if (IsPending(offer.Status))
            tags.Add("Pending");
        if (offer.IsTitleFight)
            tags.Add("Title");
        if (offer.IsTitleEliminator)
            tags.Add("Eliminator");
        if (offer.IsShortNotice)
            tags.Add("Short notice");
        return tags;
    }

    private static string BuildContractOfferPreview(ContractOfferVm offer)
        => $"{offer.OfferedFights} fights · {offer.BasePurse} base · {offer.WinBonus} win bonus · {offer.SigningBonus} signing";

    private static IReadOnlyList<string> BuildContractOfferTags(ContractOfferVm offer)
    {
        var tags = new List<string>();
        if (IsPending(offer.Status))
            tags.Add("Pending");
        tags.Add(offer.ExclusivityType);
        if (!string.IsNullOrWhiteSpace(offer.Recommendation))
            tags.Add(offer.Recommendation!);
        return tags;
    }

    private static IReadOnlyList<string> BuildMessageTags(InboxMessageVm message)
    {
        var tags = new List<string> { message.MessageType };
        if (!message.IsRead)
            tags.Add("Unread");
        if (message.IsArchived)
            tags.Add("Archived");
        return tags;
    }

    private void HandleInboxStatusChanged()
    {
        if (_busy || _loading)
            return;

        _ = InvokeAsync(ReloadAsync);
    }

    public void Dispose()
    {
        InboxStatusService.Changed -= HandleInboxStatusChanged;
    }

    private enum InboxSurfaceKind
    {
        Message,
        Decision,
        FightOffer,
        ContractOffer
    }

    private sealed record InboxSurfaceItem(
        InboxSurfaceKind Kind,
        int Id,
        string Title,
        string Subtitle,
        string Preview,
        string DateLabel,
        bool IsUnread,
        IReadOnlyList<string> Tags,
        string EmphasisClass)
    {
        public string TypeLabel => Kind switch
        {
            InboxSurfaceKind.Message => "Message",
            InboxSurfaceKind.Decision => "Decision",
            InboxSurfaceKind.FightOffer => "Fight Offer",
            InboxSurfaceKind.ContractOffer => "Contract Offer",
            _ => "Item"
        };
    }
}
